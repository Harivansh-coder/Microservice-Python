# Example environment variables (placeholders only)

JWT_SECRET_KEY=replace-with-strong-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

POSTGRES_USER=authuser
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=authdb

MONGO_INITDB_ROOT_USERNAME=mongo_root_user
MONGO_INITDB_ROOT_PASSWORD=change_me_mongo_password

DATABASE_URL=postgresql://authuser:change_me_postgres_password@postgres:5432/authdb
MONGO_URL=mongodb://mongo_root_user:change_me_mongo_password@mongodb:27017/
MONGO_DB=filestore

RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_URL=amqp://rabbitmq:5672/

REDIS_URL=redis://redis:6379

MAX_FILE_SIZE=104857600
WORKER_CONCURRENCY=2
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
